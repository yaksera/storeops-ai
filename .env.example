# Copy to .env and adjust. Never commit real secrets.

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Fernet key for encrypting Shopify access tokens at rest. Required in production.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Infrastructure ---------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://storeops:storeops@localhost:5432/storeops
REDIS_URL=redis://localhost:6379/0

# --- Web / cookies ----------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Set to true behind HTTPS.
COOKIE_SECURE=false
SESSION_TTL_SECONDS=1209600
AUTH_RATE_LIMIT_PER_MINUTE=10

# Next.js server-side address of the API (used for /api rewrites).
API_INTERNAL_URL=http://localhost:8000

# --- Demo mode --------------------------------------------------------------
DEMO_MODE_ENABLED=true
SIMULATOR_TICK_SECONDS=3
